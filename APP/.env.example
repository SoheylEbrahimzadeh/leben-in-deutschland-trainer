# Cloud sync (Part 3) — optional. Leave both unset and the app runs
# entirely on localStorage, exactly as before (guest mode only).
#
# Both values below are PUBLIC/client-safe (Supabase's anon/public key,
# protected by the Row Level Security policies in supabase/schema.sql).
# NEVER put the Supabase service-role key here or anywhere in this app.
#
# Get these from your Supabase project: Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
